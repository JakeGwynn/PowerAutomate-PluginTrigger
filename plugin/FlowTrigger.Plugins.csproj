<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dataverse plug-ins must target .NET Framework (the sandbox worker process
    does not run on .NET / .NET Core) and must be strong-name signed to be
    registered as a plug-in assembly.

    The FlowTrigger.Plugins.snk key is generated automatically by
    deploy/Deploy-FlowTriggerSolution.ps1 (via New-StrongNameKey.ps1) if it
    isn't already present. It is intentionally excluded from git (.gitignore)
    - it only needs to exist locally at build time, and does not need to be
    the same key across machines/environments.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>FlowTrigger.Plugins</AssemblyName>
    <RootNamespace>FlowTrigger.Plugins</RootNamespace>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FlowTrigger.Plugins.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.51" />
  </ItemGroup>

  <Target Name="EnsureStrongNameKey" BeforeTargets="CoreCompile" Condition="!Exists('$(MSBuildProjectDirectory)\FlowTrigger.Plugins.snk')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\New-StrongNameKey.ps1&quot;" />
  </Target>

</Project>
